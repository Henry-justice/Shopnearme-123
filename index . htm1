<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ShopNearMe - Every Business Near You</title>
<meta name="description" content="Find any business near you. Anywhere in the world. Plumber, cake, photographer, tailor - Just ShopNearMe.">
<style>
*{box-sizing:border-box;font-family:Arial,sans-serif}
body{margin:0;background:#f6f7fb;color:#111}
header{background:#0f172a;color:#fff;padding:50px 20px;text-align:center}
header h1{font-size:32px;margin:0 0 10px;line-height:1.2}
header p{opacity:.85;font-size:17px}
.logo{font-size:22px;font-weight:900;letter-spacing:1px;color:#4ade80}
.search-box{background:#fff;max-width:800px;margin:25px auto 0;padding:12px;border-radius:14px;display:flex;gap:10px;flex-wrap:wrap}
.search-box select,.search-box input{flex:1;padding:14px;border:1px solid #ddd;border-radius:10px;font-size:15px}
.btn{background:#16a34a;color:#fff;border:none;padding:14px 20px;border-radius:10px;font-weight:bold;cursor:pointer}
.btn-blue{background:#2563eb}
.container{max-width:1100px;margin:auto;padding:20px}
.cats{display:flex;gap:10px;flex-wrap:wrap;justify-content:center}
.cats button{padding:10px 16px;border-radius:20px;border:1px solid #ddd;background:#fff;cursor:pointer}
.cats button.active{background:#111;color:#fff}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;margin-top:20px}
.card{background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 4px 14px rgba(0,0,0,.06)}
.card img{width:100%;height:180px;object-fit:cover}
.card-body{padding:16px}
.badge{background:#dcfce7;color:#166534;padding:4px 8px;border-radius:20px;font-size:12px}
.card-body h3{margin:10px 0 5px}
.card-body p{color:#555;font-size:14px}
.wa{display:block;text-align:center;background:#25D366;color:#fff;padding:12px;border-radius:10px;text-decoration:none;font-weight:bold;margin-top:10px}
.section{background:#fff;border-radius:16px;padding:25px;margin-top:25px}
input,select,textarea{width:100%;padding:13px;margin:8px 0;border:1px solid #ddd;border-radius:10px}
footer{text-align:center;padding:30px;color:#777}
</style>
</head>
<body>

<header>
<div class="logo">🛍️ SHOPNEARME</div>
<h1>Find Any Business Near You — Anywhere In The World</h1>
<p>Plumber? Cake? Photographer? Tailor? Just ShopNearMe.</p>
<div class="search-box">
<select id="countryFilter">
<option value="All">All Countries</option>
<option>Nigeria</option><option>Ghana</option><option>Kenya</option>
<option>USA</option><option>UK</option><option>India</option>
<option>South Africa</option><option>Canada</option>
</select>
<input id="searchInput" placeholder="What do you need? e.g. Plumber, Cake, Photographer">
<button class="btn" onclick="filterBiz()">SEARCH</button>
</div>
<br>
<button class="btn btn-blue" onclick="document.getElementById('add').scrollIntoView({behavior:'smooth'})">Add Your Business — It's Free</button>
</header>

<div class="container">
<p style="text-align:center">⭐ Trusted by business owners in Nigeria, Ghana, Kenya, USA, UK, India & more<br><b>Every Business Near You.</b></p>

<div class="cats" id="catBtns">
<button class="active" onclick="setCat('All',this)">All</button>
<button onclick="setCat('Food',this)">Food & Drinks</button>
<button onclick="setCat('Fashion',this)">Fashion & Beauty</button>
<button onclick="setCat('Home',this)">Home Services</button>
<button onclick="setCat('Tech',this)">Tech & Digital</button>
<button onclick="setCat('Online',this)">Online Shops</button>
</div>

<div class="grid" id="bizGrid"></div>

<div class="section" id="add">
<h2>Are You a Business Owner? Get More Customers.</h2>
<p>Don't let customers find your competitor instead of you. List on ShopNearMe in 2 minutes. 100% Free to start.</p>
<input id="bName" placeholder="Business Name">
<select id="bCountry"><option>Nigeria</option><option>Ghana</option><option>Kenya</option><option>USA</option><option>UK</option><option>India</option><option>South Africa</option><option>Canada</option></select>
<input id="bCity" placeholder="City e.g. Benin City">
<select id="bCat"><option>Food</option><option>Fashion</option><option>Home</option><option>Tech</option><option>Online</option></select>
<input id="bWhat" placeholder="What do you sell? e.g. Custom cakes">
<input id="bWa" placeholder="WhatsApp Number e.g. 2348012345678">
<button class="btn" style="width:100%" onclick="addBiz()">Add My Business Now — Free</button>
</div>

<div class="section" style="text-align:center">
<h2>Why ShopNearMe?</h2>
<p><b>✅ No Commission:</b> Customers contact you directly.<br>
<b>✅ Works For Every Country:</b> From Lagos to London to New York.<br>
<b>✅ Simple:</b> If you can use WhatsApp, you can use ShopNearMe.</p>
</div>
</div>

<footer>ShopNearMe © 2026 — Every Business Near You. Anywhere In The World.</footer>

<script>
let businesses = [
{name:"Mama's Kitchen",country:"Nigeria",city:"Benin City",cat:"Food",desc:"Delicious local & continental dishes. Delivery available.",wa:"2348012345678",img:"https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=600"},
{name:"Glow Beauty Studio",country:"Ghana",city:"Accra",cat:"Fashion",desc:"Hair, nails & makeup. Book your glam session today.",wa:"233201234567",img:"https://images.unsplash.com/photo-1560066984-138dadb4c035?w=600"},
{name:"FixIt Plumbers",country:"Kenya",city:"Nairobi",cat:"Home",desc:"Fast & trusted plumbing repairs. 24/7 service.",wa:"254712345678",img:"https://images.unsplash.com/photo-1621905251189-08b45d6a269e?w=600"},
{name:"Pixel Pro Design",country:"USA",city:"New York",cat:"Tech",desc:"Logos, websites & branding for small businesses.",wa:"15551234567",img:"https://images.unsplash.com/photo-1561070791-2526d30994b5?w=600"},
{name:"London Cakes Co.",country:"UK",city:"London",cat:"Food",desc:"Custom birthday & wedding cakes. Order 2 days ahead.",wa:"447123456789",img:"https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=600"},
{name:"Desi Fashion Hub",country:"India",city:"Mumbai",cat:"Online",desc:"Trendy kurtis & sarees. Ships worldwide.",wa:"919876543210",img:"https://images.unsplash.com/photo-1445205170230-053b83016050?w=600"},
];
let currentCat="All";
function render(list){
document.getElementById('bizGrid').innerHTML = list.map(b=>`
<div class="card">
<img src="${b.img}">
<div class="card-body">
<span class="badge">${b.country} • ${b.city}</span>
<h3>${b.name}</h3>
<p><b>${b.cat}</b> — ${b.desc}</p>
<a class="wa" href="https://wa.me/${b.wa}" target="_blank">Chat on WhatsApp</a>
</div></div>`).join('') || "<p>No business found. Be the first to add one!</p>";
}
function filterBiz(){
let c=document.getElementById('countryFilter').value;
let q=document.getElementById('searchInput').value.toLowerCase();
let f=businesses.filter(b=>(c==="All"||b.country===c)&&(currentCat==="All"||b.cat===currentCat)&&(b.name.toLowerCase().includes(q)||b.desc.toLowerCase().includes(q)||b.city.toLowerCase().includes(q)));
render(f);
}
function setCat(cat,el){
currentCat=cat;
document.querySelectorAll('.cats button').forEach(b=>b.classList.remove('active'));
el.classList.add('active'); filterBiz();
}
function addBiz(){
let n=document.getElementById('bName').value;
let co=document.getElementById('bCountry').value;
let ci=document.getElementById('bCity').value;
let ca=document.getElementById('bCat').value;
let w=document.getElementById('bWhat').value;
let wa=document.getElementById('bWa').value;
if(!n||!ci||!wa){alert("Please fill Business Name, City and WhatsApp");return;}
businesses.unshift({name:n,country:co,city:ci,cat:ca,desc:w,wa:wa,img:"https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=600"});
render(businesses);
alert("Congratulations! Your business is now live on ShopNearMe");
}
render(businesses);
</script>
</body>
</html>